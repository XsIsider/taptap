    UseDialogue: 
  - Id: person_cook
    Name: "\u53A8\u5E08"
    Kind: 0
    Body: "\u793A\u4F8B\u89D2\u8272\uFF0C\u7528\u4E8E\u6F14\u793A\u4EBA\u7269\u8C03\u67E5\u518C\u7FFB\u9875\u3002"
    IconResource: 
    UseRoom: 
    UsePerson: 
    UseDialogue: 
  - Id: item_invitation
    Name: "\u9080\u8BF7\u51FD"
    Kind: 1
    Body: "\u81F4\u62C9\u5E15\u8389\u4E9A\uFF1A\n\u8BDA\u9080\u60A8\u4ECA\u665A\u6765\u5230\u53E4\u5821\u3002\u62B5\u8FBE\u540E\uFF0C\u8BF7\u5411\u8D70\u5ECA\u7684\u7BA1\u5BB6\u51FA\u793A\u6B64\u51FD\u3002\n\n\u6B64\u51FD\u5DF2\u59A5\u5584\u6536\u5165\u8C03\u67E5\u518C\u3002"
    IconResource: 
    UseRoom: 
    UsePerson: 
    UseDialogue: 
  - Id: item_map
    Name: "\u53E4\u5821\u5730\u56FE"
    Kind: 1
    Body: "\u6807\u6709\u53E4\u5821\u5404\u5C42\u7684\u5730\u70B9\u3002\u6253\u5F00\u540E\u53EF\u67E5\u770B\u5F00\u653E\u65F6\u95F4\u548C\u5F53\u524D\u4F4D\u7F6E\u3002"
    IconResource: 
    UseRoom: 
    UsePerson: 
    UseDialogue: 
  - Id: item_tape
    Name: "\u6F14\u793A\u78C1\u5E26"
    Kind: 1
    Body: "\u53EF\u5728\u8D70\u5ECA\u53CD\u590D\u64AD\u653E\u7684\u6F14\u793A\u78C1\u5E26\u3002\u70B9\u51FB\u5373\u53EF\u4F7F\u7528\u3002"
