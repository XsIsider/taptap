    UseDialogue: 
  - Id: person_guard
    Name: "\u5B88\u536B"
    Kind: 0
    Body: "\u5728\u8D70\u5ECA\u503C\u5B88\u3002\u7528\u4E8E\u6F14\u793A\u591A\u4EBA\u4EA4\u8C08\u5BF9\u8C61\u5207\u6362\u3002"
    IconResource: 
    UseRoom: 
