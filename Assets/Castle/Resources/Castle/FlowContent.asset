    - Speaker: "\u7BA1\u5BB6"
      Text: "\u4E8C\u697C\u8FD8\u6709\u753B\u5ECA\u3002\u5BF9\u767D\u65F6\u53EF\u4EE5\u67E5\u770B\u5730\u56FE\uFF0C\u7ED3\u675F\u4EA4\u8C08\u540E\u518D\u524D\u5F80\u3002"
