    - Speaker: "\u7BA1\u5BB6"
      Text: "\u8BF7\u6536\u4E0B\u8FD9\u4EFD\u53E4\u5821\u5730\u56FE\u3002\u60A8\u53EF\u4EE5\u7528\u5B83\u67E5\u770B\u5404\u5904\u7684\u5F00\u653E\u65F6\u95F4\u3002"
