  - Id: person_guest
    Name: "\u8BBF\u5BA2"
    Kind: 0
    Body: "\u5728\u8D70\u5ECA\u9047\u89C1\u7684\u8BBF\u5BA2\u3002\u6B64\u89D2\u8272\u7528\u4E8E\u5C55\u793A\u81EA\u7531\u4EA4\u8AC7\u548C\u5BF9\u767D\u9009\u9879\u3002"
    IconResource: 
    UseRoom: 
    UsePerson: 
    UseDialogue: 
  - Id: person_lady
    Name: "\u5973\u7235"
    Kind: 0
    Body: "\u53E4\u5821\u7684\u4E3B\u4EBA\u3002\u4EBA\u7269\u5185\u5BB9\u4E3A\u754C\u9762\u793A\u4F8B\uFF0C\u6B63\u5F0F\u4ECB\u7ECD\u5F85\u8865\u5145\u3002"
    IconResource: 
    UseRoom: 
